# ============================================================
#  R.O.N.Y — Fichier de configuration
#  Copiez ce fichier en .env et remplissez vos clés API
#  Ne partagez JAMAIS le fichier .env !
# ============================================================

# ── IA & LLM ─────────────────────────────────────────────────
GEMINI_API_KEY=VOTRE_CLE_GEMINI_ICI
OPENAI_API_KEY=VOTRE_CLE_OPENAI_ICI
GROQ_API_KEY=VOTRE_CLE_GROQ_ICI
ANTHROPIC_API_KEY=VOTRE_CLE_ANTHROPIC_ICI
XAI_API_KEY=VOTRE_CLE_XAI_ICI

# ── Google APIs ───────────────────────────────────────────────
YOUTUBE_API_KEY=VOTRE_CLE_YOUTUBE_ICI
SERPAPI_API_KEY=VOTRE_CLE_SERPAPI_ICI

# ── Home Assistant ────────────────────────────────────────────
# Ex: http://192.168.1.100:8123
HA_URL=http://VOTRE_IP_HOME_ASSISTANT:8123
HA_TOKEN=VOTRE_TOKEN_LONG_HOME_ASSISTANT

# ── Musique ───────────────────────────────────────────────────
# URI Spotify : clic droit sur une playlist → Partager → Copier l'URI Spotify
SPOTIFY_MUSIQUE_URI=spotify:playlist:VOTRE_PLAYLIST_ID
DEEZER_MUSIQUE_URL=https://www.deezer.com/playlist/VOTRE_PLAYLIST_ID
YOUTUBE_MUSIQUE_URL=https://music.youtube.com

# ── Localisation (météo par défaut) ───────────────────────────
VILLE_DEFAUT=Paris
LAT_DEFAUT=48.8566
LON_DEFAUT=2.3522
